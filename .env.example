# Copy this file to .env.local and fill in your keys.
# These are only read on the server and are never sent to the browser.

# Required: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional but recommended (image fallback for general topics):
# create an app at https://unsplash.com/oauth/applications and use its "Access Key"
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# Optional settings
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low            # low | medium | high (higher = slower, more careful)
# RATE_LIMIT_PER_MINUTE=5
# RATE_LIMIT_PER_HOUR=30
# MOCK_GENERATION=1            # use a built-in sample list instead of calling Claude
