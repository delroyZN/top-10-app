# Copy this file to .env.local and fill in what you need.
# These are only read on the server and are never sent to the browser.

# --- How lists are written -------------------------------------------------
# Option A (no API key): leave ANTHROPIC_API_KEY empty. The app runs the
# Claude Code CLI on this computer (`claude -p`), using your Claude
# subscription. Claude Code must be installed and signed in.
#
# Option B: set an Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Force one or the other: api | cli   (default: api if a key is set, else cli)
# CLAUDE_MODE=cli
# CLAUDE_CLI_PATH=claude        # full path to claude(.exe) if it isn't on PATH
# CLAUDE_CLI_MODEL=             # e.g. opus or sonnet; empty = your Claude Code default

# --- Images ------------------------------------------------------------------
# Optional (image fallback for general topics):
# create an app at https://unsplash.com/oauth/applications and use its "Access Key"
UNSPLASH_ACCESS_KEY=

# --- Optional settings ---------------------------------------------------------
# CLAUDE_MODEL=claude-opus-5-5  # API mode only
# CLAUDE_EFFORT=low             # low | medium | high (higher = slower, more careful)
# RATE_LIMIT_PER_MINUTE=5
# RATE_LIMIT_PER_HOUR=30
# MOCK_GENERATION=1             # use a built-in sample list instead of calling Claude
